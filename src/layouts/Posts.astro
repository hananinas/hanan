---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import slugify from "@utils/slugify";
import type { CollectionEntry } from "astro:content";
export interface Props { pageNum: number; totalPages: number; posts: CollectionEntry<"blog">[]; }
const { pageNum, totalPages, posts } = Astro.props;
---
<Layout title={`Work | ${SITE.title}`} description="Projects and notes by Hanan.">
  <Header activeNav="projects" />
  <main id="main-content" class="site-shell projects-main">
    <p class="eyebrow">Index / {String(pageNum).padStart(2, "0")}</p>
    <h1>Work and notes</h1>
    <p class="lede">Things I've built and written about. Older work stays here as a record of what I was learning at the time.</p>
    <ul class="content-list">
      {posts.map(({ data }) => <li><a href={`/projects/${slugify(data)}`}><span class="meta">{data.pubDatetime.getFullYear()}</span><span class="entry-copy"><span class="entry-title">{data.title}</span><span class="entry-desc">{data.description}</span></span><span class="entry-arrow" aria-hidden="true">↗</span></a></li>)}
    </ul>
    {totalPages > 1 && <nav class="pagination" aria-label="Pages">{pageNum > 1 && <a href={pageNum === 2 ? "/projects" : `/projects/${pageNum - 1}`}>← Newer</a>}{pageNum < totalPages && <a href={`/projects/${pageNum + 1}`}>Older →</a>}</nav>}
  </main>
  <Footer />
</Layout>
<style>
.projects-main { padding-top: 80px; padding-bottom: 130px; }
h1 { margin: 7px 0 0; font-size: clamp(2.4rem, 5vw, 4rem); letter-spacing: -.065em; line-height: 1.18; }
.lede { max-width: 56ch; color: var(--secondary); margin: 18px 0 52px; }
.pagination { display: flex; justify-content: space-between; gap: 24px; margin-top: 32px; font-size: .85rem; }
.pagination a { color: var(--accent); }
@media(max-width: 640px) { .projects-main { padding-top: 58px; padding-bottom: 85px; } }
</style>