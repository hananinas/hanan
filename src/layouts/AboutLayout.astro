---
import { SITE } from "@config";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";
export interface Props { frontmatter: { title: string; description?: string; }; }
const { frontmatter } = Astro.props;
---
<Layout title={`${frontmatter.title} | ${SITE.title}`} description={frontmatter.description}>
  <Header activeNav="about" />
  <main id="main-content" class="reading-shell about-main"><p class="eyebrow">About</p><h1>{frontmatter.title}</h1><article class="prose"><slot /></article></main>
  <Footer />
</Layout>
<style>
.about-main { padding-top: 75px; padding-bottom: 110px; }
h1 { margin: 9px 0 52px; font-size: clamp(2.4rem, 5vw, 4rem); letter-spacing: -.065em; line-height: 1.2; }
@media(max-width:640px) { .about-main { padding-top: 50px; padding-bottom: 70px; } h1 { margin-bottom: 36px; } }
</style>