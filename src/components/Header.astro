---
export interface Props {
  activeNav?: "projects" | "skils" | "studies" | "about" | "search";
}
const { activeNav } = Astro.props;
---
<header class="site-header site-shell">
  <a class="skip" href="#main-content">Skip to content</a>
  <a class="wordmark" href="/" aria-label="Hanan, home">Hanan<span class="mark">.</span></a>
  <nav aria-label="Main navigation">
    <a href="/projects" aria-current={activeNav === "projects" ? "page" : undefined}>Work</a>
    <a href="/studies" aria-current={activeNav === "studies" ? "page" : undefined}>Studies</a>
    <a href="/about" aria-current={activeNav === "about" ? "page" : undefined}>About</a>
    <a href="/search" aria-current={activeNav === "search" ? "page" : undefined}>Search</a>
  </nav>
</header>
<style>
.site-header { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; padding-top: 34px; padding-bottom: 30px; border-bottom: 1px solid var(--line); }
.wordmark { font-size: 1.15rem; font-weight: 800; letter-spacing: -.065em; text-decoration: none; white-space: nowrap; }
.mark { color: var(--accent); }
nav { display: flex; align-items: center; flex-wrap: wrap; gap: clamp(12px, 3vw, 32px); }
nav a { font-size: .82rem; text-decoration: none; color: var(--secondary); }
nav a:hover, nav a[aria-current="page"] { color: var(--ink); }
nav a[aria-current="page"] { text-decoration: underline; text-underline-offset: 7px; }
.skip { position: absolute; top: -100px; left: 18px; padding: 5px 10px; background: var(--ink); color: var(--page); z-index: 10; }
.skip:focus { top: 8px; }
@media (max-width: 560px) { .site-header { display: block; padding-top: 20px; padding-bottom: 16px; } nav { margin-top: 12px; gap: 18px; } nav a { font-size: .78rem; } }
</style>