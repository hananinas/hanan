---
const year = new Date().getFullYear();
export interface Props { noMarginTop?: boolean; }
---
<footer class="site-shell"><span>© {year} Hanan Choudhary Hadayat</span><div><a href="mailto:hanan@uai.dk">Email</a><a href="https://github.com/hananinas">GitHub</a><a href="/rss.xml">RSS</a></div></footer>
<style>
footer { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-top: auto; border-top: 1px solid var(--line); padding-top: 26px; padding-bottom: 38px; font-size: .72rem; color: var(--secondary); }
footer div { display: flex; flex-wrap: wrap; gap: 20px; }
footer a { text-decoration: none; }
@media(max-width: 600px) { footer { display: block; } footer div { margin-top: 13px; } }
</style>