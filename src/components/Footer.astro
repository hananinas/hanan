---
const year = new Date().getFullYear();
export interface Props { noMarginTop?: boolean; }
---
<footer class="site-shell"><span>© {year} Hanan Choudhary Hadayat, Copenhagen</span><div><a href="mailto:hanan@uai.dk">Email</a><a href="https://github.com/hananinas">GitHub</a><a href="/rss.xml">RSS</a></div></footer>
<style>
footer { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-top: auto; border-top: 1px dashed var(--line); padding-top: 22px; padding-bottom: 34px; font-size: .8125rem; color: var(--secondary); }
footer div { display: flex; flex-wrap: wrap; gap: 20px; }
footer a { color: var(--accent); font-style: italic; text-decoration: none; }
footer a:hover { color: var(--hover); text-decoration: underline; }
@media(max-width: 600px) { footer { display: block; } footer div { margin-top: 10px; } }
</style>
