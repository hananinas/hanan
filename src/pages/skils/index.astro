---
import { getCollection } from "astro:content";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import getUniqueTags from "@utils/getUniqueTags";
const tags = getUniqueTags(await getCollection("blog"));
---
<Layout title="Topics | Hanan" description="Browse Hanan's project notes by topic.">
  <Header activeNav="skils" />
  <main id="main-content" class="site-shell topics-main"><p class="eyebrow">Index</p><h1>Topics</h1><p class="intro">A way into the project archive. These are tags on posts, not a ranking of skills.</p><ul class="topic-list">{tags.map(tag => <li><a href={`/skils/${tag}`}>{tag} <span aria-hidden="true">↗</span></a></li>)}</ul></main>
  <Footer />
</Layout>
<style>
.topics-main { padding-top: 75px; padding-bottom: 110px; }
h1 { font-size: clamp(2.4rem, 5vw, 4rem); letter-spacing: -.065em; line-height: 1.2; margin: 8px 0; }
.intro { color: var(--secondary); max-width: 58ch; margin: 14px 0 50px; }
.topic-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit,minmax(200px,1fr)); gap: 0 30px; }
.topic-list li { border-top: 1px solid var(--line); }
.topic-list a { display: flex; justify-content: space-between; padding: 13px 0; text-decoration: none; font-size: .9rem; }
.topic-list span { color: var(--secondary); }
</style>