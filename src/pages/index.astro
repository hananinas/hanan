---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";
const posts = getSortedPosts(await getCollection("blog"));
const selected = posts.filter(({ data }) => data.featured).slice(0, 4);
---
<Layout title="Hanan | Software, research, and things I make" description="Hanan Choudhary Hadayat builds software and studies computer science at DTU.">
  <Header />
  <main id="main-content" class="site-shell">
    <section class="intro" aria-labelledby="intro-title">
      <p class="eyebrow">Copenhagen / software & research</p>
      <h1 id="intro-title">I'm Hanan.<br /><span>I make things for the internet.</span></h1>
      <p class="intro-text">I study computer science and engineering at DTU. Outside class, I build developer tools and work on Elusive, a way to find clothing worth looking for.</p>
      <div class="intro-links"><a href="/about">More about me <span aria-hidden="true">↗</span></a><a href="mailto:hanan@uai.dk">Email me <span aria-hidden="true">↗</span></a></div>
    </section>
    <section class="work" aria-labelledby="work-title">
      <div class="section-head"><h2 id="work-title" class="section-label">Selected work</h2><a href="/projects">All projects ↗</a></div>
      <ul class="content-list">
        {selected.map(({ data }) => <li><a href={`/projects/${slugify(data)}`}><span class="meta">{data.pubDatetime.getFullYear()}</span><span class="entry-copy"><span class="entry-title">{data.title}</span><span class="entry-desc">{data.description}</span></span><span class="entry-arrow" aria-hidden="true">↗</span></a></li>)}
      </ul>
    </section>
    <section id="contact" class="contact" aria-labelledby="contact-title"><h2 id="contact-title" class="section-label">Elsewhere</h2><p>I keep notes here, publish code on GitHub, and answer email.</p><div class="contact-links"><a href="https://github.com/hananinas">GitHub ↗</a><a href="mailto:hanan@uai.dk">hanan@uai.dk ↗</a></div></section>
  </main>
  <Footer />
</Layout>
<style>
.intro { padding: clamp(70px, 11vw, 138px) 0 clamp(84px, 12vw, 150px); max-width: 770px; }
.intro .eyebrow { margin: 0 0 26px; }
h1 { margin: 0; font-size: clamp(2.6rem, 6vw, 5.25rem); line-height: 1.13; letter-spacing: -.075em; font-weight: 700; }
h1 span { color: #6b736a; }
.intro-text { max-width: 590px; margin: 28px 0 0; font-size: clamp(1.02rem, 1.6vw, 1.18rem); line-height: 1.7; color: var(--secondary); }
.intro-links,.contact-links { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 28px; font-size: .85rem; font-weight: 650; }
.intro-links a,.contact-links a { text-decoration: none; border-bottom: 1px solid var(--line); padding-bottom: 3px; }
.section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; }
.section-head h2 { margin: 0; }
.section-head a { font-size: .78rem; color: var(--secondary); text-decoration: none; }
.contact { margin: 110px 0 115px; border-top: 1px solid var(--line); padding-top: 28px; }
.contact h2 { margin: 0; }
.contact p { margin: 8px 0 0; color: var(--secondary); }
.contact-links { margin-top: 18px; }
@media (max-width: 640px) { .intro { padding: 72px 0 85px; } .contact { margin: 80px 0; } }
</style>