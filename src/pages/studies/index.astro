---
import { SITE } from "@config";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
const education = [
  { degree: "MSc in Computer Science & Engineering", school: "Technical University of Denmark (DTU)", period: "2025–present" },
  { degree: "BSc in Software Development", school: "IT University of Copenhagen (ITU)", period: "Completed" },
];
const rawNotes = await getCollection("notes", ({ data }) => data.draft !== true);
const semestersMap = new Map<string, { name: string; timeframe: string; order: number; courses: Map<string, {name: string; code?: string; order: number}> }>();
for (const { data } of rawNotes) {
  let semester = semestersMap.get(data.semester);
  if (!semester) { semester = { name: data.semester, timeframe: data.timeframe, order: data.semesterOrder ?? Number.MAX_SAFE_INTEGER, courses: new Map() }; semestersMap.set(data.semester, semester); }
  if (!semester.courses.has(data.course)) semester.courses.set(data.course, { name: data.course, code: data.courseCode, order: data.courseOrder ?? Number.MAX_SAFE_INTEGER });
}
const semesters = Array.from(semestersMap.values()).sort((a,b) => a.order - b.order).map(s => ({ ...s, courses: Array.from(s.courses.values()).sort((a,b) => a.order - b.order) }));
---
<Layout title={`Studies | ${SITE.title}`} description="Hanan's education and course notes.">
  <Header activeNav="studies" />
  <main id="main-content" class="site-shell studies-main"><p class="eyebrow">Education / notes</p><h1>Studies</h1><p class="intro">What I'm studying, and a few notes kept along the way.</p>
    <section aria-labelledby="education-title"><h2 id="education-title" class="section-label">Education</h2><ul class="study-list">{education.map(item => <li><span class="meta">{item.period}</span><div><strong>{item.degree}</strong><span>{item.school}</span></div></li>)}</ul></section>
    {semesters.length > 0 && <section aria-labelledby="courses-title"><h2 id="courses-title" class="section-label">Courses in my notes</h2>{semesters.map(semester => <div class="semester"><h3>{semester.name} <span class="meta">{semester.timeframe}</span></h3><ul class="study-list">{semester.courses.map(course => <li><span class="meta">{course.code || "Course"}</span><strong>{course.name}</strong></li>)}</ul></div>)}</section>}
  </main>
  <Footer />
</Layout>
<style>
.studies-main { padding-top: 75px; padding-bottom: 110px; }
h1 { font-size: clamp(2.4rem, 5vw, 4rem); letter-spacing: -.065em; line-height: 1.2; margin: 8px 0; }
.intro { color: var(--secondary); margin: 15px 0 62px; }
section + section { margin-top: 82px; }
section h2 { margin: 0 0 18px; }
.study-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
.study-list li { display: grid; grid-template-columns: 160px 1fr; gap: 24px; border-bottom: 1px solid var(--line); padding: 20px 0; align-items: baseline; }
.study-list li div { display: flex; flex-direction: column; }
.study-list strong { font-size: .95rem; font-weight: 650; }
.study-list li div span { color: var(--secondary); font-size: .82rem; }
.semester { margin-top: 30px; }
.semester h3 { display: flex; justify-content: space-between; align-items: baseline; gap: 15px; margin: 0 0 12px; font-size: 1.02rem; }
@media(max-width:640px) { .studies-main { padding-top: 50px; padding-bottom: 70px; } .study-list li { grid-template-columns: 1fr; gap: 3px; padding: 15px 0; } }
</style>