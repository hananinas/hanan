---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Search from "@components/Search";
import slugify from "@utils/slugify";
const posts = await getCollection("blog", ({ data }) => !data.draft);
const searchList = posts.map(entry => ({ title: entry.data.title, description: entry.data.description ?? "", data: entry.data, type: "blog" as const, slug: slugify(entry.data), content: entry.body }));
---
<Layout title="Search | Hanan" description="Search Hanan's project archive.">
  <Header activeNav="search" />
  <main id="main-content" class="site-shell search-main"><p class="eyebrow">Archive</p><h1>Search</h1><p class="intro">Find a project or an older note.</p><Search client:load searchList={searchList} /></main>
  <Footer />
</Layout>
<style>
.search-main { padding-top: 75px; padding-bottom: 110px; }
h1 { font-size: clamp(2.4rem,5vw,4rem); letter-spacing: -.065em; margin: 8px 0; line-height: 1.2; }
.intro { color: var(--secondary); margin: 15px 0 40px; }
</style>